RewriteEngine On
RewriteBase /itemstracker/

# Let real files and directories pass through unchanged.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback (except API) to the application; index.html is the sales page.
RewriteCond %{REQUEST_URI} !^/itemstracker/api/
RewriteRule ^ app.html [L]

# Safari must revalidate the HTML and fixed-name application assets after an upload.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  # Content-hashed presentation assets change URL whenever their content changes.
  <FilesMatch "\.[a-f0-9]{16}\.(css|js|woff2|svg|png|jpe?g|webp)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain text/vtt
</IfModule>
