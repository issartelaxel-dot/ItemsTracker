# Required
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Frontend URL allowed by CORS
CLIENT_ORIGIN=https://setup-hub.com
CLIENT_ORIGINS=https://setup-hub.com,https://www.setup-hub.com

# Email approval workflow
ADMIN_APPROVAL_EMAIL=issartelaxel@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_user

# Optional
PORT=8787
NODE_ENV=development
# For same-site setup (setup-hub.com + api.setup-hub.com), keep `lax`.
# If frontend and API are on different sites (e.g. setup-hub.com -> onrender.com), use:
# COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Keep strict TLS verification enabled in production (default = true).
# Set to false only for temporary troubleshooting with known/trusted infra.
DB_SSL_REJECT_UNAUTHORIZED=true
JSON_BODY_LIMIT=32mb
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_DISPLAY_NAME=Admin

# Version coordonnée frontend/backend (rebuild frontend requis)
APP_VERSION=0.1.0
MIN_CLIENT_VERSION=0.1.0
# Données actives : quota logique utilisateur, distinct de l'espace physique Neon.
STORAGE_LIMIT_BYTES=2147483648
STATE_SNAPSHOT_RETENTION_DAYS=30
STATE_IDEMPOTENCY_RETENTION_HOURS=72

# Optionnel : stockage objet S3 PRIVÉ, compatible Hetzner.
# Vide = médias dédupliqués dans PostgreSQL ; aucun nouvel abonnement requis.
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=itemstracker/media
MEDIA_S3_FORCE_PATH_STYLE=true
