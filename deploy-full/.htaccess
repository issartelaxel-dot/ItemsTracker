RewriteEngine On
RewriteBase /itemstracker/

# Let real files and directories pass through unchanged.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback (except API) to the application; index.html is the sales page.
RewriteCond %{REQUEST_URI} !^/itemstracker/api/
RewriteRule ^ app.html [L]
