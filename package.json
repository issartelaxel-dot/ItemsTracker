{
  "name": "items-trackers-tom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "npm run dev:restore-index && vite",
    "server": "node server/index.mjs",
    "dev:full": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "npm run dev:restore-index && tsc -b && vite build && node scripts/prepare-landing-deploy.mjs",
    "build:deploy": "npm run build && cp .htaccess dist/.htaccess",
    "package:deploy": "npm run build:deploy && node scripts/prepare-deploy.mjs",
    "package:full": "npm run export:ready && node scripts/prepare-full-deploy.mjs",
    "export:ready": "npm run build && node scripts/prepare-root-export.mjs",
    "export:zip": "npm run export:ready",
    "dev:restore-index": "node scripts/restore-dev-index.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "import:items": "node scripts/import-items.mjs",
    "test:backup": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "backup:create": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "neon:pitr": "node scripts/neon-pitr.mjs",
    "test:browser": "node tests/browser-save.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@lexical/html": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "healthicons": "^2.0.0",
    "helmet": "^8.1.0",
    "iconoir-react": "^7.11.1",
    "jsonwebtoken": "^9.0.3",
    "lexical": "^0.49.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "read-excel-file": "^9.0.6",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
