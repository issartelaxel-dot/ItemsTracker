[Unit]
Description=ItemsTracker daily encrypted backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=itemstracker
Group=itemstracker
WorkingDirectory=/opt/itemstracker
EnvironmentFile=/etc/itemstracker/backup.env
ExecStart=/usr/bin/node /opt/itemstracker/scripts/backup.mjs create
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/itemstracker
