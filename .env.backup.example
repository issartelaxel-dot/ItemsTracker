# Charger uniquement sur le serveur de sauvegarde, hors du répertoire public.
# Connexion Neon DIRECTE (le hostname ne doit pas contenir -pooler).
BACKUP_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BACKUP_DIRECTORY=/var/backups/itemstracker
# Générer : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Conserver la clé séparément des archives ; elle est indispensable à la restauration.
BACKUP_ENCRYPTION_KEY=
PG_DUMP_PATH=/usr/bin/pg_dump
PG_RESTORE_PATH=/usr/bin/pg_restore

# Ajouter les mêmes accès MEDIA_S3 que l'API si les images sont externalisées.
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=itemstracker/media
# Suppression de médias remplacés/supprimés : délai après leur retrait, pas leur création.
MEDIA_GC_ENABLED=false
MEDIA_GC_RETENTION_DAYS=45

# Test de restauration, cible VIDE et isolée. Jamais DATABASE_URL de l'application.
RESTORE_DATABASE_URL=
# Si médias S3 : bucket de test distinct + accès séparés.
RESTORE_MEDIA_S3_BUCKET=
RESTORE_MEDIA_S3_ENDPOINT=
RESTORE_MEDIA_S3_REGION=eu-central-1
RESTORE_MEDIA_S3_ACCESS_KEY_ID=
RESTORE_MEDIA_S3_SECRET_ACCESS_KEY=

# Gestion Neon (pas nécessaire au fonctionnement de la sauvegarde externe).
NEON_PROJECT_ID=
NEON_API_KEY=
NEON_PITR_DAYS=7
